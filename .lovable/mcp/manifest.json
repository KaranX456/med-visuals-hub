{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://rsmgkwbzadibqprahukk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "health-companion-portal",
      "version": "0.1.0",
      "title": "Health Companion Portal"
    },
    "tools": [
      {
        "name": "get_health_summary",
        "title": "Get health summary",
        "description": "Summarise the signed-in user's record: profile, recent symptoms, active medications, latest labs, history and triage records.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_symptoms",
        "title": "List logged symptoms",
        "description": "List the signed-in user's logged symptoms, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Maximum number of entries to return (default 20).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "log_symptom",
        "title": "Log a symptom",
        "description": "Record a new symptom entry for the signed-in patient.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Symptom name, e.g. 'Night sweats'."
            },
            "severity": {
              "description": "Severity from 1 (mild) to 10 (severe).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "onset": {
              "description": "Onset date as YYYY-MM-DD.",
              "type": "string"
            },
            "frequency": {
              "description": "How often it occurs, e.g. 'Most days'.",
              "type": "string"
            },
            "notes": {
              "description": "Free-text context.",
              "type": "string"
            },
            "tags": {
              "description": "Body-system tags, e.g. ['Respiratory'].",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "name"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_medications",
        "title": "List medications",
        "description": "List the signed-in user's medications with dose, schedule, adherence and today's status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "includeInactive": {
              "description": "Include stopped medications (default false).",
              "type": "boolean"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "mark_medication_taken",
        "title": "Mark medication taken",
        "description": "Mark one of the signed-in user's medications as taken (or not taken) today.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "medicationId": {
              "type": "string",
              "description": "Medication id from list_medications."
            },
            "taken": {
              "description": "Set to false to undo. Defaults to true.",
              "type": "boolean"
            }
          },
          "required": [
            "medicationId"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_lab_results",
        "title": "List lab results",
        "description": "List the signed-in user's lab analytes with values, units and reference ranges.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "panel": {
              "description": "Filter to a single panel name, e.g. 'Complete Blood Count'.",
              "type": "string"
            },
            "limit": {
              "description": "Maximum rows to return (default 50).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
